# backend/.env.example
# 复制此文件为 .env 并填写真实值

# JWT 安全配置
SECRET_KEY=your-secret-key-here          # 请生成随机字符串（如 openssl rand -hex 32）
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 数据库（SQLite）— 路径由 config.py 自动计算
# 如需自定义路径，取消下面注释并修改:
# DATABASE_URL=sqlite:///C:/your/path/data/app.db

# Chroma 向量数据库持久化目录 — 路径由 config.py 自动计算
# CHROMA_PERSIST_DIR=C:/your/path/data/chroma_data

# ---------- DeepSeek API 配置（兼容 OpenAI 接口）----------
OPENAI_API_KEY=sk-98bfadfe1b5243df961028b95e39925d   # 从 platform.deepseek.com 获取
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat                   # 或 deepseek-reasoner（推理模型）

# Embedding 模型（若使用 OpenAI Embedding，需单独设置；若本地部署可改用其他）
# 此处保留为 OpenAI 格式，但 DeepSeek 无 embedding 服务，请根据需要替换：
# 方案1：继续使用 OpenAI text-embedding-ada-002（需额外 key）
# 方案2：使用本地 SentenceTransformer（后续配置）
EMBEDDING_MODEL=text-embedding-ada-002